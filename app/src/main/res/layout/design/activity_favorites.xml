<?xml version="1.0" encoding="utf-8"?>

<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.ConstraintLayoutDesign
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/favoritesLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- ========================================== -->
    <!-- TOP TOOLBAR                                -->
    <!-- ========================================== -->

    <org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
        android:id="@+id/toolbar_Favorites"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="13dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back button -->
        <org.appdevforall.codeonthego.layouteditor.editor.palette.buttons.ImageButtonDesign
            android:id="@+id/backButton_Favorites"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_back"
            style="?android:attr/borderlessButtonStyle" />

        <!-- Title + status -->

        <org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
            android:id="@+id/titleAndStatus_Favorites"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
                android:id="@+id/txtTitle_Favorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Favorites"
                android:textColor="?attr/colorOnSurface"
                android:textSize="28sp"
                android:textStyle="bold" />

            <org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
                android:id="@+id/txtStatus_Favorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="No favorite channels"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp" />

        </org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>

        <!-- Push search button to the right -->

        <!--<android.widget.Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />-->

        <!-- Search -->

        <org.appdevforall.codeonthego.layouteditor.editor.palette.widgets.SearchViewDesign
            android:id="@+id/searchView_Favorites"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:iconifiedByDefault="true"
            android:queryHint="Search channels"
            android:background="@android:color/transparent" 
            android:layout_gravity="center_horizontal|right" />
        
    </org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>


    <!-- ========================================== -->
    <!-- SWIPE REFRESH + GRID                       -->
    <!-- ========================================== -->

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout_Favorites"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"

        app:layout_constraintTop_toBottomOf="@id/toolbar_Favorites"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <org.appdevforall.codeonthego.layouteditor.editor.palette.legacy.GridViewDesign
            android:id="@+id/channelGrid_Favorites"
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:numColumns="2"

            android:horizontalSpacing="12dp"
            android:verticalSpacing="12dp"

            android:padding="2dp"
            android:clipToPadding="false"

            android:stretchMode="columnWidth" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.ConstraintLayoutDesign>